# DriftZero Environment Configuration

# Nebius AI Studio Token Factory API Key (Required for LLM code refactoring & reasoning)
NEBIUS_API_KEY=your_nebius_api_key_here

# Tavily AI Search API Key (Required for live documentation search & extract)
TAVILY_API_KEY=your_tavily_api_key_here

# GitHub Personal Access Token (Required for cloning private repos & opening PRs)
GITHUB_TOKEN=your_github_pat_token_here

# Optional: Nebius Serverless Jobs API Endpoint (Recommended for container sandboxing in Compose/production)
# When set, DriftZero dispatches verification jobs to Nebius Serverless Jobs API.
# If not set, verification requires either local Docker daemon access or ALLOW_UNSAFE_LOCAL_SANDBOX=1.
# NEBIUS_SERVERLESS_JOB_ENDPOINT=https://jobs.api.nebius.ai/v1

# Optional: DriftZero API Key (enforces X-API-Key check on /api/migrate/stream when set)
# Required. Generate with: openssl rand -hex 32  (placeholders/short keys are rejected at startup)
DRIFTZERO_API_KEY=
# Set to 1 only when the backend is behind a proxy you control (compose frontend proxy)
TRUSTED_PROXY=0

# Optional: Local repository safety toggle (default 0; 1 allows local workspace paths inside allowlist)
ALLOW_LOCAL_REPOS=0

# Optional: Fallback local process sandbox safety toggle (default 0).
# Set to 1 only in trusted local/dev environments when Docker daemon and Nebius job endpoint are unavailable.
ALLOW_UNSAFE_LOCAL_SANDBOX=0

# Optional: Rate limiting & concurrency caps on /api/migrate/stream
RATE_LIMIT_PER_MINUTE=10
MAX_CONCURRENT_MIGRATIONS=2

# Backend service URL for Next.js rewrite proxy (build arg and runtime)
BACKEND_URL=http://backend:8000

# Frontend API URL configuration (reverse proxy or direct backend port)
NEXT_PUBLIC_API_URL=http://localhost:8000
